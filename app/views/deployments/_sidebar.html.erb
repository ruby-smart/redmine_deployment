<% if @project %>
  <h3><%= l(:label_deployments) %></h3>
  <ul>
    <li><%= link_to l(:label_overview), project_deployments_path(@project), class: 'icon icon-report' %></li>
    <li><%= link_to l(:label_statistics), statistics_project_deployments_path(@project), class: 'icon icon-stats' %></li>
  </ul>
<% end %>

<%= call_hook(:view_deployments_sidebar_queries_top) %>
<%= render_sidebar_queries(DeploymentQuery, @project) %>
<%= call_hook(:view_deployments_sidebar_queries_bottom) %>
