<div class="contextual">
  <%= render :partial => 'navigation' %>
</div>

<h2><%= l(:label_deployment_statistics) %></h2>

<div class="deployment-graph">
  <canvas id="deployments_per_month"></canvas>
</div>

<div class="deployment-graph">
  <canvas id="deployments_per_author"></canvas>
</div>


<%= javascript_tag do %>
// The color of a dataset comes with the data: one color per environment of the project, the same in every graph
// (DeploymentsController::ENVIRONMENT_COLORS, assigned per environment - not per position in a graph)
function deploymentDatasets(data){
  return data['datasets'].map(function(ds){
    return {
      label: ds['name'],
      backgroundColor: ds['color'] + 'b3', // 70% opaque
      borderColor: ds['color'],
      borderWidth: 1,
      data: ds['data']
    };
  });
}

$(document).ready(function(){
  $.getJSON(<%= raw url_for(:controller => 'deployments', :action => 'graph',
    :project_id => @project, :graph => "deployments_per_month").to_json %>, function(data){

    new Chart(document.getElementById("deployments_per_month").getContext("2d"), {
      type: 'bar',
      data: {labels: data['labels'], datasets: deploymentDatasets(data)},
      options: {
        elements: {bar: {borderWidth: 2}},
        responsive: true,
        plugins: {
          legend: {position: 'right'},
          title: {display: true, text: <%= raw l(:label_deployments_per_month).to_json %>}
        },
        scales: {
          xAxis: {stacked: true},
          yAxis: {stacked: true, ticks: {precision: 0}}
        }
      }
    });
  });

  $.getJSON(<%= raw url_for(:controller => 'deployments', :action => 'graph',
    :project_id => @project, :graph => "deployments_per_author").to_json %>, function(data){

    new Chart(document.getElementById("deployments_per_author").getContext("2d"), {
      type: 'bar',
      data: {labels: data['labels'], datasets: deploymentDatasets(data)},
      options: {
        indexAxis: 'y',
        elements: {bar: {borderWidth: 2}},
        responsive: true,
        plugins: {
          legend: {position: 'right'},
          title: {display: true, text: <%= raw l(:label_deployments_per_author).to_json %>}
        },
        scales: {
          xAxis: {stacked: true, ticks: {precision: 0}},
          yAxis: {stacked: true}
        }
      }
    });
  });
});
<% end %>


<p><%= link_to l(:button_back), project_deployments_path(@project) %></p>

<% content_for :sidebar do %>
  <%= render :partial => 'deployments/sidebar' %>
<% end %>

<% html_title(l(:label_deployments), l(:label_statistics)) -%>

<% content_for :header_tags do %>
  <%= javascript_include_tag "chart.min" %>
<% end %>
