<div class="contextual">
  <%= render :partial => 'navigation' %>
</div>

<h2><%= l(:label_deployment_statistics) %></h2>

<div class="deployment-graph">
  <canvas id="deployments_per_month"></canvas>
</div>

<div class="deployment-graph">
  <canvas id="deployments_per_author"></canvas>
</div>


<%= javascript_tag do %>
// The color of a dataset comes with the data: one color per environment of the project, the same in every graph
// (DeploymentsController::ENVIRONMENT_COLORS, assigned per environment - not per position in a graph)
function deploymentDatasets(data){
  return data['datasets'].map(function(ds){
    return {
      label: ds['name'],
      backgroundColor: ds['color'] + 'b3', // 70% opaque
      borderColor: ds['color'],
      borderWidth: 1,
      data: ds['data']
    };
  });
}

// Redmine 7 ships Chart.js as an ES module behind the importmap ("chart.js"), up to Redmine 6 it was the global Chart
var deploymentChartJs;
function deploymentLoadChart(){
  if (!deploymentChartJs) {
    deploymentChartJs = window.Chart ? Promise.resolve(window.Chart)
                                     : import('chart.js').then(function(m){ return m.default; });
  }
  return deploymentChartJs;
}

function deploymentChart(url, canvasId, options){
  $.when($.getJSON(url), deploymentLoadChart()).done(function(response, Chart){
    var data = response[0];
    new Chart(document.getElementById(canvasId).getContext("2d"), {
      type: 'bar',
      data: {labels: data['labels'], datasets: deploymentDatasets(data)},
      options: options
    });
  });
}

$(document).ready(function(){
  deploymentChart(<%= raw url_for(:controller => 'deployments', :action => 'graph',
    :project_id => @project, :graph => "deployments_per_month").to_json %>, "deployments_per_month", {
    elements: {bar: {borderWidth: 2}},
    responsive: true,
    plugins: {
      legend: {position: 'right'},
      title: {display: true, text: <%= raw l(:label_deployments_per_month).to_json %>}
    },
    scales: {
      x: {stacked: true},
      y: {stacked: true, ticks: {precision: 0}}
    }
  });

  deploymentChart(<%= raw url_for(:controller => 'deployments', :action => 'graph',
    :project_id => @project, :graph => "deployments_per_author").to_json %>, "deployments_per_author", {
    indexAxis: 'y',
    elements: {bar: {borderWidth: 2}},
    responsive: true,
    plugins: {
      legend: {position: 'right'},
      title: {display: true, text: <%= raw l(:label_deployments_per_author).to_json %>}
    },
    scales: {
      x: {stacked: true, ticks: {precision: 0}},
      y: {stacked: true}
    }
  });
});
<% end %>


<p><%= link_to l(:button_back), project_deployments_path(@project) %></p>

<% content_for :sidebar do %>
  <%= render :partial => 'deployments/sidebar' %>
<% end %>

<% html_title(l(:label_deployments), l(:label_statistics)) -%>

<%# Redmine 7 serves Chart.js through the importmap, see deploymentLoadChart %>
<% if Redmine::VERSION::MAJOR < 7 %>
  <% content_for :header_tags do %>
    <%= javascript_include_tag "chart.min" %>
  <% end %>
<% end %>
