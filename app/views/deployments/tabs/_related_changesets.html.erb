<% if @related_changesets.any? %>
  <table class="list changesets">
    <thead>
      <tr>
        <th><%= l(:label_revision) %></th>
        <th><%= l(:field_author) %></th>
        <th><%= l(:field_committed_on) %></th>
        <th><%= l(:field_comments) %></th>
      </tr>
    </thead>
    <tbody>
      <% @related_changesets.each do |changeset| %>
        <tr class="changeset <%= cycle('odd', 'even') %>">
          <td class="id"><%= link_to_revision(changeset, @deployment.repository) %></td>
          <td class="author"><%= changeset.author %></td>
          <td class="committed_on"><%= format_time(changeset.committed_on) %></td>
          <td class="comments"><%= textilizable(changeset.short_comments) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p class="nodata"><%= l(:label_no_data) %></p>
<% end %>
